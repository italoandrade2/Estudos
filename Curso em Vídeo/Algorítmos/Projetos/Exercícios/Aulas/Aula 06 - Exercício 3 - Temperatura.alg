// Aula 06 - Exercício 3 - Temperatura
// Nome: Italo Andrade Costa
// 21/05/2026 - Versão 1.0

algoritmo "Temperatura"
var
   fahrenheit, celsius: Real
inicio
    Escreva("Quantos ºF são agora? ")
    Leia(fahrenheit)
       
    celsius <- (fahrenheit-32)/1.8
       
    Escreva("Então são ", celsius, "ºC no Brasil agora")
fimalgoritmo