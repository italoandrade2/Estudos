algoritmo "Sequências Básicas 04"

var
    num1, num2, soma: Inteiro
inicio
    Escreva ("Digite um valor: ")
    Leia (num1)
    Escreva ("Digite outro valor: ")
    Leia (num2)

    soma <- num1 + num2
    Escreva ("A soma entre", num1, " e", num2, " é igual a", soma, ".")
fimalgoritmo