algoritmo "Sequências Básicas 06"

var
    num1, num2, num3: Inteiro
inicio
    Escreva ("Digite um número: ")
    Leia (num2)
    
    num1 := num2 - 1
    num3 := num2 + 1
    
    EscrevaL ("O antecessor de", num2, " é", num1)
    EscrevaL ("O sucessor de", num2, " é", num3)
fimalgoritmo