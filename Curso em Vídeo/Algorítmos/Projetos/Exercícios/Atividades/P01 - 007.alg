algoritmo "Sequências Básicas 07"

var
    num1, num2, num3: Real
inicio
    Escreva ("Digite um número: ")
    Leia (num2)
    
    num1 := num2 * 2
    num3 := num2 / 3
    
    EscrevaL ("O dobro de", num2, " é", num1)
    EscrevaL ("A terça parte de", num2, " é", num3)
fimalgoritmo