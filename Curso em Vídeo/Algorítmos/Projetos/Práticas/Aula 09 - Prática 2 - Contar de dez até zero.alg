// Aula 09 - Prática 2 - Contar de dez até zero
// Nome: Italo Andrade Costa
// 27/05/2026 - Versão 1.0

algoritmo "Conte de 10 até 0"
var
    contador: Inteiro
inicio
    contador <- 10
    Enquanto (contador >= 0) faca
        EscrevaL(contador)
        contador <- contador - 1
    FimEnquanto
    EscrevaL("Terminei de contar")
fimalgoritmo