algoritmo "Sequências Básicas 15"

var
    dias, salario: Real
inicio
    Escreva ("Digite a quantia de dias trabalhados: ")
    Leia (dias)
    
    salario := (8*25) * dias

    Escreva ("O salário do funcionário é igual a R$", salario:5:2, ".")
fimalgoritmo