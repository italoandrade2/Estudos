algoritmo "Condições Básicas 20"

var
    num: Inteiro
inicio
    Escreva ("Digite um número: ")
    Leia (num)
    
    Se (num % 2 = 0) então
        Escreva ("O número", num, " é par.")
    senão
        Escreva ("O número", num, " é ímpar.")
    FimSe
fimalgoritmo