// Aula 09 - Prática 1 - Conte até dez
// Nome: Italo Andrade Costa
// 27/05/2026 - Versão 1.0

algoritmo "Conte até 10"
var
    contador: Inteiro
inicio
    contador <- 0
    Enquanto (contador <= 10) faca
        EscrevaL(contador)
        contador <- contador + 1
    FimEnquanto
    EscrevaL("Terminei de contar")
fimalgoritmo