algoritmo "Sequências Básicas 03"

var
    nome: Caractere
    salario: Real
inicio
    Escreva ("Nome do Funcionário: ")
    Leia (nome)
    Escreva ("Salário: ")
    Leia (salario)
    Escreva ("O funcionário ", nome, " tem um salário de R$", salario, " em Junho.")
fimalgoritmo